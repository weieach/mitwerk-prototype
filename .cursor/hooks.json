{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/screenshot-prompt.sh",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/screenshot-prompt.sh",
        "timeout": 20,
        "failClosed": false
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/screenshot-push.sh",
        "matcher": "git\\s+push",
        "timeout": 30,
        "failClosed": false
      }
    ]
  }
}
