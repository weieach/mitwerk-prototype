#!/bin/sh
# Capture the running app on git push and include the PNG in that push.
set -e

if [ "${MITWERK_SCREENSHOT_HOOK:-}" = "1" ] || [ "${MITWERK_SCREENSHOT_SKIP:-}" = "1" ]; then
  exit 0
fi

export PATH="/usr/local/bin:/opt/homebrew/bin:${HOME}/.local/bin:${PATH}"

remote="$1"
root="$(git rev-parse --show-toplevel)"
cd "$root"
NODE="$(command -v node || true)"
if [ -z "$NODE" ]; then
  echo "pre-push: node is not on PATH; cannot capture a progress screenshot." >&2
  exit 1
fi

zeros="0000000000000000000000000000000000000000"
local_sha=""
remote_sha=""
remote_ref=""
has_update=0

# GUI clients (Cursor / VS Code) often invoke pre-push with empty stdin.
if [ ! -t 0 ]; then
  while read -r _local_ref _local_sha _remote_ref _remote_sha; do
    if [ -z "$_local_sha" ] || [ "$_local_sha" = "$zeros" ]; then
      continue
    fi
    if [ "$_local_sha" = "$_remote_sha" ]; then
      continue
    fi
    has_update=1
    local_sha="$_local_sha"
    remote_sha="$_remote_sha"
    remote_ref="$_remote_ref"
    break
  done
fi

if [ "$has_update" -eq 0 ]; then
  local_sha="$(git rev-parse HEAD)"
  branch="$(git rev-parse --abbrev-ref HEAD)"
  remote_ref="refs/heads/$branch"
  if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    remote_sha="$(git rev-parse '@{u}')"
    if [ "$local_sha" = "$remote_sha" ]; then
      echo "pre-push: HEAD already matches upstream; skipping screenshot." >&2
      exit 0
    fi
  else
    remote_sha="$zeros"
  fi
fi

echo "pre-push: capturing progress screenshot for $local_sha" >&2
file="$("$NODE" "$root/scripts/screenshot-progress.mjs" --tag push --sha "$local_sha" --base "$remote_sha")"

echo "" >&2
echo "Progress screenshot saved locally:" >&2
echo "  $file" >&2
echo "" >&2
