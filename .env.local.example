# Copy to .env.local. This file is gitignored — never commit real values.

# --- Option A: hosted / multi-user (recommended) ---------------------------
# Create an app at https://www.figma.com/developers/apps (self-serve, no
# approval). Add a redirect URL that matches FIGMA_REDIRECT_URI exactly.
# Scopes requested: file_content:read, file_comments:write, current_user:read
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:5173/api/auth/callback

# --- Option B: local only, just you -----------------------------------------
# A personal access token, used when the OAuth values above are blank.
# Figma: Settings -> Security -> Personal access tokens
FIGMA_TOKEN=
