# Progress captures are tracked through Git LFS; the capture script's local state is not
\[frame capture\] screenshots/.*
!\[frame capture\] screenshots/.gitattributes
# Retired push-tree copies (pushes now load from Git via data/push-shas.json)
\[ver capture\] codebase/

dist/

# Exported capture videos and other generated media
exports/

# Rebuildable archived prototype bundles
.mitwerk-prototypes/

# Local Vercel project link and deployment output
.vercel/
