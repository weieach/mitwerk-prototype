{
  "name": "mitwerk-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "screenshot": "node scripts/screenshot-progress.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "verify:gallery": "node --experimental-strip-types scripts/verify-gallery.ts",
    "publish:gallery": "node --experimental-strip-types scripts/publish-gallery.ts",
    "deploy:vercel": "npm run build:vercel && npx vercel deploy --prebuilt --prod && npm run verify:gallery -- https://mitwerk-prototype.vercel.app --published",
    "spike": "node archive/review-comment-spike/scripts/spike.mjs",
    "start": "node server/standalone.mjs",
    "bench": "node archive/review-comment-spike/scripts/bench-lookup.mjs",
    "export:xr": "node --experimental-strip-types scripts/export-xr.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@phosphor-icons/web": "^2.1.2",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.138.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vercel/blob": "^2.8.2",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
